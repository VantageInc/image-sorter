{
  "name": "image-sorter",
  "productName": "Image Sorter",
  "version": "1.1.0",
  "description": "A private, offline desktop contact sheet for finding, filtering, and safely exporting images from large folders.",
  "author": "VantageInc",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VantageInc/image-sorter.git"
  },
  "homepage": "https://github.com/VantageInc/image-sorter#readme",
  "bugs": {
    "url": "https://github.com/VantageInc/image-sorter/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@10.9.8",
  "overrides": {
    "brace-expansion@<2.0.0": "1.1.18",
    "brace-expansion@>=2.0.0 <3.0.0": "2.1.4",
    "brace-expansion@>=3.0.0 <4.0.0": "3.0.6",
    "brace-expansion@>=5.0.0 <6.0.0": "5.0.9"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "build": "npm run build:app",
    "build:app": "tsc -b --pretty false && vite build",
    "dist": "npm run build:app && electron-builder --publish never",
    "dist:win": "npm run build:app && electron-builder --win --x64 --publish never",
    "dist:mac:x64": "npm run build:app && electron-builder --mac --x64 --publish never",
    "dist:mac:arm64": "npm run build:app && electron-builder --mac --arm64 --publish never",
    "smoke:packaged": "node scripts/smoke-packaged.mjs release",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "exifr": "^7.1.3",
    "image-size": "^2.0.3",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@electron/fuses": "1.8.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^43.2.0",
    "electron-builder": "26.15.7",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vite-plugin-electron": "^1.1.0",
    "vitest": "^3.2.4"
  }
}
